{
  "endpoint": "minimax/h3-max/reference-to-video",
  "capabilities": {
    "controls": {
      "aspectRatio": {
        "path": "/aspect_ratio",
        "values": ["9:16", "16:9", "1:1", "3:4", "4:3", "21:9"]
      },
      "resolution": {
        "path": "/resolution",
        "values": ["480P", "768P", "1080P"]
      },
      "duration": {
        "path": "/duration",
        "min": 5,
        "max": 15
      }
    }
  }
}
